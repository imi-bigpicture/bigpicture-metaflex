<!-- version:2.0.0 -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bp="BP.common">
    <xs:import namespace="BP.common" schemaLocation="BP.common.xsd" />

    <xs:complexType name="AnnotationTaskFileType">
        <xs:complexContent>
            <xs:extension base="bp:FileBaseType">
                <xs:attribute name="filetype" use="required">
                    <xs:annotation>
                        <xs:documentation>The type of the file.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="doc" />
                            <xs:enumeration value="docx" />
                            <xs:enumeration value="pdf" />
                            <xs:enumeration value="txt" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="AnnotationTaskSetType">
        <xs:sequence maxOccurs="unbounded" minOccurs="1">
            <xs:element name="ANNOTATION_TASK" type="AnnotationTaskType" />
        </xs:sequence>
    </xs:complexType>
    <xs:element name="ANNOTATION_TASK_SET" type="AnnotationTaskSetType">
        <xs:annotation>
            <xs:documentation>A container of annotation task objects.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="ANNOTATION_TASK" type="AnnotationTaskType" />

    <xs:complexType name="AnnotationTaskType">
        <xs:annotation>
            <xs:documentation>The task that has been performed when creating annotations.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="bp:ObjectType">
                <xs:sequence>
                    <xs:element name="FILE" minOccurs="1" maxOccurs="1"
                        type="AnnotationTaskFileType">
                        <xs:annotation>
                            <xs:documentation>Data file associated with the annotation task.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="ATTRIBUTES" minOccurs="1" maxOccurs="1"
                        type="bp:AttributesType" nillable="true" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
</xs:schema>